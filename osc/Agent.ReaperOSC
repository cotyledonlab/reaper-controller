# Agent.ReaperOSC — narrowed OSC surface for reaper-controller (not a control surface).
#
# Install: copy to <ResourcePath>/OSC/Agent.ReaperOSC, then
#   Preferences -> Control/OSC/Web -> Add -> OSC:
#   UDP, listen on 8000, send to 127.0.0.1:9000, pattern = Agent.
# One-time human step (~2 min); everything after is agent-driven.
#
# Design: 32 fixed tracks, bank 0, follows DEVICE — /track/N/... always means
# REAPER track N (1-based), no bank-switching, no selection side-effects
# (REAPER_TRACK_FOLLOWS REAPER leaves the user's track selection alone).
# Only @-addressed patterns: the agent always says which track it means.
#
# Types: t=trigger (no arg), b=bool (int 0/1), n=normalized 0..1 float,
#   f=absolute float, s=string, i=int. Same patterns carry feedback back.
#
# Flood note: VU + TIME/BEAT feedback is chatty by design (telemetry wants
# it). If it ever floods, comment out TRACK_VU/MASTER_VU first.

DEVICE_TRACK_COUNT 32
DEVICE_SEND_COUNT 0
DEVICE_RECEIVE_COUNT 0
DEVICE_FX_COUNT 4
DEVICE_FX_PARAM_COUNT 8
DEVICE_FX_INST_PARAM_COUNT 8
DEVICE_MARKER_COUNT 0
DEVICE_REGION_COUNT 0

REAPER_TRACK_FOLLOWS REAPER
DEVICE_TRACK_FOLLOWS DEVICE
DEVICE_TRACK_BANK_FOLLOWS DEVICE
DEVICE_FX_FOLLOWS DEVICE

# transport
PLAY t/play
STOP t/stop
RECORD t/record
REPEAT t/repeat
TIME s/time/str
BEAT s/beat/str

# tempo: n/tempo sets (normalized; verify mapping live, see pitfalls),
# s/tempo/str echoes back the true BPM — always trust the echo, not the send.
TEMPO n/tempo s/tempo/str

# tracks (1-based N, explicit)
TRACK_NAME s/track/@/name
TRACK_VOLUME n/track/@/volume
TRACK_PAN n/track/@/pan
TRACK_MUTE b/track/@/mute t/track/@/mute/toggle
TRACK_SOLO b/track/@/solo
TRACK_VU n/track/@/vu

# master
MASTER_VOLUME n/master/volume
MASTER_VU n/master/vu

# universal gap-filler: /action <command-id> triggers any REAPER action.
# (Action list in REAPER shows IDs; e.g. 40044 toggles metronome.)
ACTION i/action t/action/@
